# PostgreSQL 비밀번호
POSTGRES_PASSWORD=postgres

# run profile (default) dev
# SPRING_PROFILES_ACTIVE=prod

# JWT 서명 비밀키 (HS256 — 32바이트 이상)
JWT_SECRET=please-change-this-to-a-32-byte-minimum-secret-key

# JWT 만료 시간 (밀리초). 기본 1시간
JWT_EXPIRATION_MILLIS=3600000

# Python FastAPI 베이스 URL (Day 5)
PYTHON_BASE_URL=http://localhost:8000